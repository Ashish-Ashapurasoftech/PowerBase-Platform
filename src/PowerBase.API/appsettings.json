  "AllowedHosts": "*",
  "AzureAiSearch": {
    "Endpoint": "https://powerbase-ai-search.search.windows.net",
    "ApiKey": "<YOUR_AZURE_SEARCH_API_KEY>",
    "IndexName": "powerbase-records-index",
    "IsMultipleIndex": false,
    "UseAzureAiForGridSearch": false,
    // How tenants map to indexes. 1 = everything in IndexName. N > 1 spreads tenants over pb-shard-001..N by tenant id; a tenant's data is
    // never split. Changing it later moves tenants between indexes and needs a full reindex.
    "ShardCount": 1,
    // With IsMultipleIndex=true, these tenants get their own index "pb-tenant-{id}" (comma-separated tenant ids).
    "DedicatedTenantIds": "",
    // How many tables may have their own index "pb-tbl-{id}" (a table with more than 150 search fields). Each counts against the service's
    // index limit (15 Basic, 50 S1, 200 S2/S3). 0 switches the feature off.
    "WideTableIndexBudget": 10,
    // Sign in as the app's managed identity instead of ApiKey (roles: Search Service Contributor, Search Index Data Contributor).
    "UseManagedIdentity": false,
    // Dropping the live index through /admin/search/create-index?force=true, /reset-index or /purge-tenant is refused unless this is true,
    // and the request repeats the index name (tenant id) in "confirm". Leave false except while it is needed.
    "AllowDestructiveAdmin": false
    // Customer-managed key for index encryption (applied only when an index is created; an existing index must be rebuilt):
    // "EncryptionKey": { "VaultUri": "https://<vault>.vault.azure.net/", "KeyName": "<key>", "KeyVersion": "<version>" }
  },
  "AzureServiceBus": {
    "ConnectionString": "<YOUR_SERVICE_BUS_CONNECTION_STRING>",
    "SearchIndexQueue": "search-indexing-queue",
    "SearchIndexPriorityQueue": "search-indexing-priority-queue",
    // Set to false where the priority queue has not been created: priority messages then use the standard queue.
    "SearchIndexPriorityQueueEnabled": true,
    // Deliveries after which the indexer dead-letters a message with the error text. Keep it at or below the queue's own maximum delivery count (10 by default).
    "MaxDeliveryAttempts": 10
    // Use the app's managed identity instead of ConnectionString (roles: Azure Service Bus Data Sender / Data Receiver):
    // "FullyQualifiedNamespace": "<namespace>.servicebus.windows.net"
  },
  "Search": {
    "Indexer": {
      "Enabled": true
    },
    // Makes sure no record change is lost on the way to the search index. Every record write also writes a row to meta.SearchOutbox (same
    // transaction); the indexer deletes it once the record is indexed; this relay re-publishes rows still there after GraceSeconds, and
    // checks every tenant once a day (DailySweepHourUtc), logging what is unconfirmed.
    "Outbox": {
      "Enabled": true,
      "RelayIntervalSeconds": 30,
      "GraceSeconds": 120,
      "RetryAfterSeconds": 300,
      "MaxAttempts": 10,
      "BatchSize": 500,
      "TenantConcurrency": 4,
      "DailySweepHourUtc": 2,
      "StaleAfterMinutes": 30
    }
  }
}
