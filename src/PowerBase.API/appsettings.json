  "PipelineExecution": {
    "PrefetchCount": 5,
    "MaxRetryCount": 3,
    "TenantConcurrencyLimit": 5,
    "IdempotencyCacheDurationMinutes": 5,
    "WorkerShutdownWaitSeconds": 10,
    "SqlDeadlockMaxRetries": 3,
    "PerInstanceTenantConcurrencyLimit": 5,
    "EnableLoopBatches": true,
    "LoopBatchSize": 100,
    "BulkCreateRecordsInLoops": true,
    "AutoScaleLoopWorkers": false,
    "LoopConcurrency": 4, //if AutoScaleLoopWorkers = true -> 16
    "PerInstanceLoopConcurrency": 16, //if AutoScaleLoopWorkers = true -> 32
    "BulkEventPageSize": 500,
    "SearchRecordsPageSize": 500,
    "StreamSearchAboveRecords": 10000,
    "MaxStepOutputBytes": 0,
    "DatabaseQueue": {
      "RelayPollingIntervalSeconds": 5,
      "QueuePollingIntervalSeconds": 2,
      "RelayTenantConcurrency": 4,
      "RelayBatchSize": 50,
      "ExecutionBatchSize": 20,
      "GlobalConcurrencyLimit": 50,
      "TenantConcurrencyLimit": 10,
      "PipelineConcurrencyLimit": 3,
      "LeaseSeconds": 120,
      "HeartbeatSeconds": 30,
      "MaxAttempts": 5,
      "BaseRetryDelaySeconds": 10,
      "RetentionDays": 14,
      "CleanupBatchSize": 500,
      "CleanupMaxBatchesPerRun": 10,
      "CleanupIntervalHours": 24
    }
